# Supabase — obrigatórias
# Encontre esses valores em: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Web Push (opcional) — chave pública VAPID para lembretes de leitura via push.
# Gere um par com: npx web-push generate-vapid-keys
# A chave PRIVADA vai nos secrets da edge function (VAPID_PRIVATE_KEY), nunca aqui.
VITE_VAPID_PUBLIC_KEY=

# Copie este arquivo para .env.local e preencha com suas chaves reais.
# Nunca faça commit do .env.local — ele está no .gitignore.
